# Design documents are private: they stay on this machine and never go to GitHub (the whole folder).
concept/
.DS_Store
# Test tooling: installed packages and the reports, screenshots and diffs each run writes
node_modules/
tests/reports/

# Raw asset drops from the team (gigabytes of Unity packs): converted assets go into assets/, the raw files never into git
incoming assets/
# Models converted from the licensed packs: kept out of git until the repo is private (their licences forbid publishing them)
assets/models/pack/
# Sounds converted from the licensed packs: the same
assets/sounds/pack/
# Item icons rendered from the pack models and the SharpUI interface sprites (tools/assets/icons.mjs): the same
assets/ui/pack/
# The private backup of the above (tools/assets/backup.mjs): its own git history, pushed to the team's private repo
.assets-git/
